# Fixture, MIME Applications Associations 1.0.1 sections 3 and 4.
[Default Applications]
image/png=mine.desktop
image/gif=missing.desktop;viewer.desktop;
text/plain=editor.desktop;
application/pdf=viewer.desktop

[Added Associations]
image/png=editor.desktop;
# Added and removed in the same file: the addition survives (section 3).
image/bmp=both.desktop;

[Removed Associations]
# unwanted.desktop registers image/png; only this line keeps it out.
image/png=unwanted.desktop;
# lowadd.desktop is added in sys/config/mimeapps.list, a lower file.
image/webp=lowadd.desktop;
image/bmp=both.desktop;
